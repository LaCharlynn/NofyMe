<UserControl x:Class="NofyMe.Pages.NotificationsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pages="clr-namespace:NofyMe.Pages">
    <UserControl.Resources>
        <pages:ChipTextConverter x:Key="ChipText"/>
        <pages:ModeNameConverter x:Key="ModeName"/>
    </UserControl.Resources>

    <Grid>
        <!-- Estado vazio -->
        <StackPanel x:Name="EmptyHint" VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0.65">
            <Path Data="M6 8a6 6 0 1 1 12 0c0 7 3 9 3 9H3s3-2 3-9 M10.3 21a1.9 1.9 0 0 0 3.4 0"
                  Width="26" Height="26" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,6,0,0"
                  Stroke="{DynamicResource Faint}" StrokeThickness="2" Fill="Transparent"
                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            <TextBlock Text="Nenhuma notificação ainda."
                       TextAlignment="Center" Margin="0,10,0,0"
                       FontFamily="Segoe UI" FontSize="14" Foreground="{DynamicResource Sub}"/>
            <TextBlock Text="Toque em “+ Nova notificação” para criar a primeira."
                       TextAlignment="Center"
                       FontFamily="Segoe UI" FontSize="13" Foreground="{DynamicResource Faint}"/>
        </StackPanel>

        <!-- Lista de cartões -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Padding="0,0,6,0">
            <ItemsControl x:Name="List">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Style="{StaticResource CardButton}" Margin="0,6,0,6"
                            Click="Card_Click"
                            AutomationProperties.Name="{Binding Title}"
                            ToolTip="Editar notificação">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="40" Height="40" CornerRadius="12"
                                    Background="{DynamicResource ActiveBg}">
                                    <Path Data="M6 8a6 6 0 1 1 12 0c0 7 3 9 3 9H3s3-2 3-9 M10.3 21a1.9 1.9 0 0 0 3.4 0"
                                          Width="20" Height="20" Stretch="Uniform"
                                          Stroke="{DynamicResource Accent}" StrokeThickness="2" Fill="Transparent"
                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Border>

                            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}"
                                           Foreground="{DynamicResource Text}"
                                           FontFamily="Segoe UI" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Mode, Converter={StaticResource ModeName}}"
                                           Foreground="{DynamicResource Faint}"
                                           FontFamily="Segoe UI" FontSize="13" Margin="0,2,0,0"/>
                            </StackPanel>

                            <Border Grid.Column="2" Style="{StaticResource Chip}"
                                    VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="{Binding Converter={StaticResource ChipText}}"
                                           FontFamily="Segoe UI" FontSize="12" VerticalAlignment="Center"
                                           Foreground="{DynamicResource Sub}"/>
                            </Border>

                            <ToggleButton Grid.Column="3" Style="{StaticResource Switch}"
                                          IsChecked="{Binding Enabled, Mode=TwoWay}"
                                          Click="Switch_Click"
                                          VerticalAlignment="Center"/>

                            <Button x:Name="BtnDelete" Grid.Column="4" Style="{StaticResource IconBtn}"
                                    Margin="10,0,0,0" VerticalAlignment="Center"
                                    Foreground="{DynamicResource Faint}" Opacity="0.55"
                                    Click="Delete_Click"
                                    ToolTip="Excluir notificação"
                                    AutomationProperties.Name="{Binding Title, StringFormat=Excluir {0}}">
                                <Path Data="M3 6h18M8 6V4h8v2M6 6l1 14h10l1-14M10 10v6M14 10v6"
                                      Width="16" Height="16" Stretch="Uniform"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.8" StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            </Button>
                        </Grid>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
