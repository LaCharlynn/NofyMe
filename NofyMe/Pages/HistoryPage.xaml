<UserControl x:Class="NofyMe.Pages.HistoryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <StackPanel x:Name="EmptyHint" VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0.65">
            <TextBlock Text="Nada disparou ainda."
                       TextAlignment="Center" FontFamily="Segoe UI" FontSize="14"
                       Foreground="{DynamicResource Sub}"/>
            <TextBlock Text="O registro de cada notificação aparece aqui."
                       TextAlignment="Center" FontFamily="Segoe UI" FontSize="13"
                       Foreground="{DynamicResource Faint}"/>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Padding="0,0,6,0">
        <ItemsControl x:Name="List">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}" Margin="0,6,0,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="40" Height="40" CornerRadius="12"
                                    Background="{DynamicResource ActiveBg}">
                                <Path Data="M6 8a6 6 0 1 1 12 0c0 7 3 9 3 9H3s3-2 3-9 M10.3 21a1.9 1.9 0 0 0 3.4 0"
                                      Width="20" Height="20" Stretch="Uniform"
                                      Stroke="{DynamicResource Accent}" StrokeThickness="2" Fill="Transparent"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Border>

                            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Title}"
                                               Foreground="{DynamicResource Text}"
                                               FontFamily="Segoe UI" FontSize="15" FontWeight="SemiBold"/>
                                    <Border Style="{StaticResource Chip}" Margin="10,0,0,0"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Mode}" FontFamily="Segoe UI" FontSize="12"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Sub}"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding Message}"
                                           Foreground="{DynamicResource Faint}"
                                           FontFamily="Segoe UI" FontSize="13"
                                           Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <TextBlock Grid.Column="2" Text="{Binding FiredAt, StringFormat='HH:mm'}"
                                       FontFamily="Segoe UI" FontSize="12"
                                       Foreground="{DynamicResource Faint}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
