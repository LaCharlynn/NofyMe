<Window x:Class="NofyMe.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NofyMe"
        Width="404" Height="182"
        WindowStyle="None" AllowsTransparency="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Background="Transparent">

    <!-- margem = espaço para a sombra; o cartão tem 380x148 como no design -->
    <Border x:Name="Root" Margin="12,10,12,14" CornerRadius="22"
            Background="{DynamicResource Panel}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="32" ShadowDepth="12" Direction="270" Opacity="0.4"/>
        </Border.Effect>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Column="0" Grid.RowSpan="2" Width="40" Height="40"
                        CornerRadius="12" Background="{DynamicResource ActiveBg}"
                        VerticalAlignment="Top">
                    <Path Data="M6 8a6 6 0 1 1 12 0c0 7 3 9 3 9H3s3-2 3-9 M10.3 21a1.9 1.9 0 0 0 3.4 0"
                          Width="20" Height="20" Stretch="Uniform"
                          Stroke="{DynamicResource AccentSoft}" StrokeThickness="2" Fill="Transparent"
                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                </Border>

                <TextBlock Grid.Column="1" Text="{Binding Title}"
                           FontFamily="Segoe UI" FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource Text}" Margin="12,0,0,0"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="1" Grid.Row="1" Text="{Binding Message}"
                           TextWrapping="Wrap" MaxHeight="34" TextTrimming="CharacterEllipsis"
                           FontFamily="Segoe UI" FontSize="13"
                           Foreground="{DynamicResource Sub}" Margin="12,2,0,0"/>

                <TextBlock Grid.Column="2" Text="agora" Grid.Row="0"
                           FontFamily="Segoe UI" FontSize="12"
                           Foreground="{DynamicResource Faint}" Margin="10,0,0,0"/>
            </Grid>

            <StackPanel Grid.Row="1" Orientation="Horizontal"
                        HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button x:Name="BtnSnooze" Content="Adiar 10 min"
                        Style="{StaticResource PillGhost}" Height="32" Padding="14,0"
                        FontSize="13" Click="Snooze_Click"/>
                <Button x:Name="BtnDismiss" Content="Dispensar"
                        Style="{StaticResource PillPrimary}" Height="32" Padding="14,0"
                        FontSize="13" Margin="8,0,0,0"
                        Click="Dismiss_Click"/>
            </StackPanel>

            <!-- Barra de tempo: trilho cheio e preenchimento que esvazia em 6 s -->
            <Border Grid.Row="2" Height="3" CornerRadius="2"
                    Background="{DynamicResource ChipBg}" Margin="0,16,0,0">
                <Border x:Name="Progress" HorizontalAlignment="Left"
                        Height="3" CornerRadius="2"
                        Background="{DynamicResource Accent}" Width="340"/>
            </Border>
        </Grid>
    </Border>
</Window>
